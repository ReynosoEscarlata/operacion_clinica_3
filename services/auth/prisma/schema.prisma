// output explícito (no el default): con npm workspaces node_modules está
// hoisted a la raíz -- sin esto, "prisma generate" de este servicio
// pisaría el cliente generado de los otros 4 (todos resuelven a
// node_modules/@prisma/client de la raíz por default). Cada servicio
// necesita su propio cliente porque cada uno tiene un schema distinto.
generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// RFC-004-rbac.md: los 6 roles con cuenta (patient queda fuera -- RFC-001,
// el paciente nunca tiene cuenta, se identifica por posesión del UUID de su
// cita). Reemplaza ADMIN/STAFF (Fase 4, ver migración de backfill).
enum UserRole {
  PLATFORM_ADMIN
  PLATFORM_SUPPORT
  CLINIC_OWNER
  CLINIC_ADMIN
  DOCTOR
  RECEPTIONIST
}

// tenantId NULLABLE (RFC-003-tenancy.md, "Usuarios de plataforma en el modelo
// de datos"): NULL identifica exclusivamente a roles de plataforma
// (platform_admin/platform_support, RFC-004) — no es un tenant más, es la
// ausencia explícita de tenant. La política RLS de esta tabla tiene una
// excepción explícita para ese caso (ver migración SQL).
model User {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String?   @db.Uuid
  email        String    @unique
  name         String
  passwordHash String
  role         UserRole  @default(RECEPTIONIST)
  // Referencia por id al Doctor dueño de esta cuenta en services/doctors --
  // sin FK real (RFC-001, cero estado compartido entre servicios, mismo
  // patrón que Appointment.doctorId). Solo se puebla cuando role = DOCTOR
  // (regla de negocio en users.service.ts, no un constraint de motor).
  // Alimenta el claim doctorId del JWT (Fase 4) que habilita el filtro ABAC
  // de propiedad de RFC-004 ("un doctor solo ve sus propias citas").
  doctorId     String?   @db.Uuid
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshTokens RefreshToken[]

  @@index([tenantId])
  @@index([doctorId])
}

// Hash del refresh token (nunca el token en texto plano), con rotación:
// al refrescar, el token usado se revoca y se emite uno nuevo.
// tenantId denormalizado desde User -- NULLABLE (Fase 4): un usuario de
// plataforma (tenantId null) ahora sí puede loguearse (RFC-004), así que
// su refresh token hereda el mismo NULL. Necesario para que la política RLS
// de esta tabla no dependa de un JOIN contra User.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String?   @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
}

// RFC-004-rbac.md, "Escalada de privilegios: acceso de soporte de
// plataforma": un platform_support/platform_admin que necesita ver datos de
// un tenant específico solicita un grant temporal con motivo obligatorio.
// Append-only por convención de la app (users.repository.ts nunca expone
// update/delete, y app_role no tiene esos privilegios -- ver migración
// SQL): inmutabilidad REAL de motor (hash chain, S3 Object Lock) es Fase 5,
// esto es deliberadamente el mínimo viable para Fase 4.
model SupportAccessGrant {
  id        String    @id @default(uuid()) @db.Uuid
  actorId   String    @db.Uuid
  tenantId  String    @db.Uuid
  reason    String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([actorId, tenantId])
  @@index([expiresAt])
}

// Outbox (ADR-002-transacciones-distribuidas.md): UserCreated/UserDeactivated
// se escriben aquí en la misma transacción que el cambio de User. tenantId
// nullable, igual que User (un evento de un usuario de plataforma no tiene
// tenant). El relay que los publica es trabajo de la Fase 3b (ADR-014).
model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String?   @db.Uuid
  type        String
  payload     Json
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId])
  @@index([publishedAt])
}
