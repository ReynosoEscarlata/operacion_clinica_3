// output explícito (no el default): con npm workspaces node_modules está
// hoisted a la raíz -- sin esto, "prisma generate" de este servicio
// pisaría el cliente generado de los otros 4 (todos resuelven a
// node_modules/@prisma/client de la raíz por default). Cada servicio
// necesita su propio cliente porque cada uno tiene un schema distinto.
generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STAFF
}

// tenantId NULLABLE (RFC-003-tenancy.md, "Usuarios de plataforma en el modelo
// de datos"): NULL identifica exclusivamente a roles de plataforma
// (platform_admin/platform_support, RFC-004) — no es un tenant más, es la
// ausencia explícita de tenant. La política RLS de esta tabla tiene una
// excepción explícita para ese caso (ver migración SQL).
model User {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String?   @db.Uuid
  email        String    @unique
  name         String
  passwordHash String
  role         UserRole  @default(STAFF)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshTokens RefreshToken[]

  @@index([tenantId])
}

// Hash del refresh token (nunca el token en texto plano), con rotación:
// al refrescar, el token usado se revoca y se emite uno nuevo.
// tenantId denormalizado desde User (NOT NULL: un token de plataforma sin
// tenant no es un caso soportado hoy — los roles de plataforma no se
// construyen en esta fase, ver ADR-005/RFC-003) — necesario para que la
// política RLS de esta tabla no dependa de un JOIN contra User.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
}

// Outbox (ADR-002-transacciones-distribuidas.md): UserCreated/UserDeactivated
// se escriben aquí en la misma transacción que el cambio de User. tenantId
// nullable, igual que User (un evento de un usuario de plataforma no tiene
// tenant). El relay que los publica es trabajo de la Fase 3b (ADR-014).
model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String?   @db.Uuid
  type        String
  payload     Json
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId])
  @@index([publishedAt])
}
