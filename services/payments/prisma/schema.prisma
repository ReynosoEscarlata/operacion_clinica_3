// output explícito: con npm workspaces node_modules está hoisted a la raíz,
// ver el mismo comentario en services/auth/prisma/schema.prisma.
generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Idempotencia de webhooks (patrón obligatorio según CLAUDE.md): se inserta
// antes de procesar, marcando processedAt al terminar. Si el insert falla
// por unique constraint, el evento ya fue reclamado por otra instancia/
// reintento y se ignora.
//
// tenantId NULLABLE (a diferencia de OutboxEvent): Stripe manda TODOS los
// tipos de evento a un único endpoint de webhook compartido por tenants, y
// no todo evento trae un PaymentIntent con metadata.tenantId resoluble (ej.
// un tipo de evento sin manejador, o un PaymentIntent creado antes de esta
// migración). Esta tabla es puramente de idempotencia/auditoría interna
// -- ningún endpoint la expone por tenant -- así que NULL simplemente
// significa "tenant no resuelto", no "plataforma" (RLS más abajo).
model WebhookEvent {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String?   @db.Uuid
  stripeEventId String    @unique
  type          String
  payload       Json
  processedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([tenantId])
}

// Audit log inmutable (Fase 5, ADR-013): append-only por privilegio de
// motor (app_role solo tiene SELECT/INSERT, ver migración SQL). Sin
// hash-chaining (decisión consciente de ADR-013). tenantId NOT NULL: solo
// se escribe cuando el handler ya resolvió el tenant desde el metadata del
// PaymentIntent (mismo criterio que OutboxEvent en este servicio -- si no
// hay tenant, tampoco hay outbox ni audit log, solo un log de advertencia).
model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  createdAt     DateTime @default(now())
  tenantId      String   @db.Uuid
  actorId       String?
  actorRole     String?
  action        String
  resourceType  String
  resourceId    String?
  ip            String?
  userAgent     String?
  correlationId String?
  result        String
  justification String?

  @@index([tenantId, createdAt])
  @@index([resourceType, resourceId])
}

// Outbox (ADR-002): PaymentSucceeded/PaymentFailed/RefundIssued se escriben
// aquí al procesar el webhook, en la misma transacción que marcar el
// WebhookEvent como procesado. El relay a Redis Streams (Fase 3) los
// publica; Appointments los consume para avanzar su propia state machine
// — Payments nunca toca la BD de Appointments directamente (RFC-001).
// tenantId NOT NULL: solo se escribe cuando el handler ya resolvió el
// tenant desde el metadata del PaymentIntent (ver webhook.service.ts).
model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  type        String
  payload     Json
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId, publishedAt])
}
