// output explícito: con npm workspaces node_modules está hoisted a la raíz,
// ver el mismo comentario en services/auth/prisma/schema.prisma.
generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Read-model propio (RFC-001 decisión 4): Notifications no consulta la BD
// de Appointments/Doctors — reconstruye lo que necesita a partir de los
// eventos que consume (AppointmentCreated/StatusChanged, PatientUpdated,
// DoctorCreated/Updated). Solo se guardan los campos que realmente se usan
// para armar los emails, no una copia completa de cada entidad.
// tenantId NOT NULL (Fase 3b, ADR-014): el envelope de eventos de dominio
// trae tenantId de punta a punta desde que los 5 productores migraron a
// SNS/SQS -- recién ahí fue posible cerrar la tenancy de este servicio sin
// adivinar el contrato (ver docs/runbooks/migracion-tenant-id.md).
model AppointmentSnapshot {
  id          String   @id @db.Uuid
  tenantId    String   @db.Uuid
  patientId   String   @db.Uuid
  doctorId    String   @db.Uuid
  dateTime    DateTime
  amountCents Int      @default(0)
  status      String
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

model PatientSnapshot {
  id        String   @id @db.Uuid
  tenantId  String   @db.Uuid
  email     String
  name      String
  // Fase 5, derecho ARCO de oposición: propagado desde Appointments (dueño
  // de Patient) vía el payload de PatientUpdated. true bloquea el envío de
  // recordatorios (no transaccionales) en notification.service.ts -- las
  // transaccionales (confirmación, cancelación, pago fallido) lo ignoran.
  optOut    Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// Todavía no se reciben eventos reales de Doctors (sigue siendo un
// esqueleto sin lógica de negocio) — el modelo queda listo para cuando
// Doctors se extraiga de verdad. Hasta entonces los emails usan un
// fallback genérico en vez del nombre del doctor (ver notification.service.ts).
model DoctorSnapshot {
  id        String   @id @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  specialty String
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// Auditoría de envíos (éxito y fallo) — equivalente al AppointmentEvent
// EMAIL_SENT/EMAIL_FAILED del monolito, pero en la BD propia de
// Notifications (cero estado compartido).
model NotificationLog {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  appointmentId String   @db.Uuid
  channel       String
  type          String
  status        String
  error         String?
  createdAt     DateTime @default(now())

  @@index([tenantId, appointmentId])
}

// Dead-letter para eventos de dominio que fallaron de forma permanente al
// procesarse (ej. error de Resend agotando reintentos). Resuelve el gap
// documentado en SPEC.md: sin esto, un evento "venenoso" se queda
// reintentando para siempre en la cola.
model DeadLetterEntry {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  eventId     String
  eventType   String
  payload     Json
  error       String
  attempts    Int      @default(1)
  failedAt    DateTime @default(now())

  @@index([tenantId, eventType])
}

// Audit log inmutable (Fase 5, ADR-013): append-only por privilegio de
// motor (app_role solo tiene SELECT/INSERT, ver migración SQL). Sin
// hash-chaining (decisión consciente de ADR-013). tenantId NOT NULL --
// solo audita las rutas de dead-letter (gateadas a platform_admin,
// RFC-004): list/retry/remove exponen payloads con PII de eventos de
// dominio fallidos de un tenant ajeno al actor, exactamente el escenario
// de acceso escalado que ADR-013 exige trazar.
model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  createdAt     DateTime @default(now())
  tenantId      String   @db.Uuid
  actorId       String?
  actorRole     String?
  action        String
  resourceType  String
  resourceId    String?
  ip            String?
  userAgent     String?
  correlationId String?
  result        String
  justification String?

  @@index([tenantId, createdAt])
  @@index([resourceType, resourceId])
}
